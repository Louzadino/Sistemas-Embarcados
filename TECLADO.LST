     1                                  ; RESUMO: Módulo responsável pelo tratamento de hardware do teclado 
     2                                  ; através da interrupção INT 9h (substituindo a leitura padrão por software).
     3                                  
     4                                  segment data
     5                                      ; Exportação das variáveis globais de estado das teclas (1 = pressionada, 0 = solta)
     6                                      global key_a, key_d, key_left, key_right, key_q
     7                                      global key_t, key_m, key_n, key_r
     8                                      global key_w, key_s, key_up, key_down
     9                                      global key_enter                      ; <-- 1. NOVO: Exporta a flag da tecla Enter
    10                                      global key_y
    11                                  
    12 00000000 00                          key_a        db 0
    13 00000001 00                          key_d        db 0
    14 00000002 00                          key_left     db 0
    15 00000003 00                          key_right    db 0
    16 00000004 00                          key_q        db 0
    17 00000005 00                          key_t        db 0
    18 00000006 00                          key_m        db 0
    19 00000007 00                          key_n        db 0
    20 00000008 00                          key_r        db 0
    21 00000009 00                          key_w        db 0
    22 0000000A 00                          key_s        db 0
    23 0000000B 00                          key_up       db 0
    24 0000000C 00                          key_down     db 0
    25 0000000D 00                          key_enter    db 0                      
    26 0000000E 00                          key_y        db 0
    27                                  
    28                                      ; Armazenamento do vetor original da interrupção de teclado do DOS
    29 0000000F 0000                        velho_isr_off dw 0
    30 00000011 0000                        velho_isr_seg dw 0
    31                                  
    32                                  segment code
    33                                      global instala_teclado, restaura_teclado
    34                                  
    35                                  ; FUNÇÃO: INSTALA_TECLADO
    36                                  instala_teclado:
    37 00000000 50                          PUSH AX
    38 00000001 53                          PUSH BX
    39 00000002 06                          PUSH ES
    40 00000003 31C0                        XOR AX, AX
    41 00000005 8EC0                        MOV ES, AX                      ; Aponta para a IVT (Segmento 0)
    42                                      
    43 00000007 268B1E2400                  MOV BX, [ES:24h]
    44 0000000C 891E[0F00]                  MOV [velho_isr_off], BX
    45 00000010 268B1E2600                  MOV BX, [ES:26h]
    46 00000015 891E[1100]                  MOV [velho_isr_seg], BX
    47                                      
    48 00000019 FA                          CLI                             ; Desativa interrupções
    49 0000001A 26C7062400[4A00]            MOV word [ES:24h], nova_int9    ; Insere a nova rotina
    50 00000021 268C0E2600                  MOV word [ES:26h], CS
    51 00000026 FB                          STI                             ; Reativa interrupções
    52                                      
    53 00000027 07                          POP ES
    54 00000028 5B                          POP BX
    55 00000029 58                          POP AX
    56 0000002A C3                          RET
    57                                  
    58                                  ; FUNÇÃO: RESTAURA_TECLADO
    59                                  restaura_teclado:
    60 0000002B 50                          PUSH AX
    61 0000002C 53                          PUSH BX
    62 0000002D 06                          PUSH ES
    63 0000002E 31C0                        XOR AX, AX
    64 00000030 8EC0                        MOV ES, AX
    65                                      
    66 00000032 FA                          CLI
    67 00000033 8B1E[0F00]                  MOV BX, [velho_isr_off]
    68 00000037 26891E2400                  MOV [ES:24h], BX                ; Restaura o offset original
    69 0000003C 8B1E[1100]                  MOV BX, [velho_isr_seg]
    70 00000040 26891E2600                  MOV [ES:26h], BX                ; Restaura o segmento original
    71 00000045 FB                          STI
    72                                      
    73 00000046 07                          POP ES
    74 00000047 5B                          POP BX
    75 00000048 58                          POP AX
    76 00000049 C3                          RET
    77                                  
    78                                  ; ROTINA DE INTERRUPÇÃO DE HARDWARE (INT 9h)
    79                                  nova_int9:
    80 0000004A 50                          PUSH AX
    81 0000004B 1E                          PUSH DS
    82 0000004C B8[0000]                    MOV AX, data
    83 0000004F 8ED8                        MOV DS, AX                      ; Configura o segmento de dados local
    84                                      
    85 00000051 E460                        IN AL, 60h                      ; Lê o scancode da porta 60h
    86                                  
    87 00000053 3CE0                        CMP AL, 0E0h                    ; Ignora códigos de prefixo estendido
    88 00000055 7503                        JNE continua
    89 00000057 E9EE01                      JMP fim_int9
    90                                  continua:
    91                                  
    92                                      ; MOVIMENTO P1 (Teclas A e D) 
    93 0000005A 3C1E                        CMP AL, 1Eh         ; Make A
    94 0000005C 7503                        JNE continua_reseta_a
    95 0000005E E9FF00                      JMP seta_a
    96                                  continua_reseta_a:
    97 00000061 3C9E                        CMP AL, 9Eh         ; Break A
    98 00000063 7503                        JNE continua_seta_d
    99 00000065 E90001                      JMP reseta_a
   100                                  continua_seta_d:
   101 00000068 3C20                        CMP AL, 20h         ; Make D
   102 0000006A 7503                        JNE continua_reseta_d
   103 0000006C E90101                      JMP seta_d
   104                                  continua_reseta_d:
   105 0000006F 3CA0                        CMP AL, 0A0h        ; Break D
   106 00000071 7503                        JNE continua_seta_left
   107 00000073 E90201                      JMP reseta_d
   108                                  
   109                                      ; MOVIMENTO P2 (Setas Esquerda/Direita e teclas J/L) 
   110                                  continua_seta_left:
   111 00000076 3C4B                        CMP AL, 4Bh         ; Seta Esquerda (Make)
   112 00000078 7503                        JNE continua_seta_left_j
   113 0000007A E90301                      JMP seta_left
   114                                  continua_seta_left_j:
   115 0000007D 3C24                        CMP AL, 24h         ; Tecla J (Make)
   116 0000007F 7503                        JNE continua_reseta_left
   117 00000081 E9FC00                      JMP seta_left
   118                                  continua_reseta_left:
   119 00000084 3CCB                        CMP AL, 0CBh        ; Seta Esquerda (Break)
   120 00000086 7503                        JNE continua_reseta_left_j
   121 00000088 E9FD00                      JMP reseta_left
   122                                  continua_reseta_left_j:
   123 0000008B 3CA4                        CMP AL, 0A4h        ; Tecla J (Break)
   124 0000008D 7503                        JNE continua_seta_right
   125 0000008F E9F600                      JMP reseta_left
   126                                  
   127                                  continua_seta_right:
   128 00000092 3C4D                        CMP AL, 4Dh         ; Seta Direita (Make)
   129 00000094 7503                        JNE continua_seta_right_l
   130 00000096 E9F700                      JMP seta_right
   131                                  continua_seta_right_l:
   132 00000099 3C26                        CMP AL, 26h         ; Tecla L (Make)
   133 0000009B 7503                        JNE continua_reseta_right
   134 0000009D E9F000                      JMP seta_right
   135                                  continua_reseta_right:
   136 000000A0 3CCD                        CMP AL, 0CDh        ; Seta Direita (Break)
   137 000000A2 7503                        JNE continua_reseta_right_l
   138 000000A4 E9F100                      JMP reseta_right
   139                                  continua_reseta_right_l:
   140 000000A7 3CA6                        CMP AL, 0A6h        ; Tecla L (Break)
   141 000000A9 7503                        JNE continua_seta_t
   142 000000AB E9EA00                      JMP reseta_right
   143                                  
   144                                      ; SOCOS (Teclas T e M) 
   145                                  continua_seta_t:
   146 000000AE 3C14                        CMP AL, 14h         ; Make T
   147 000000B0 7503                        JNE continua_reseta_t
   148 000000B2 E9F300                      JMP seta_t
   149                                  continua_reseta_t:
   150 000000B5 3C94                        CMP AL, 94h         ; Break T
   151 000000B7 7503                        JNE continua_seta_m
   152 000000B9 E9F400                      JMP reseta_t
   153                                  continua_seta_m:
   154 000000BC 3C32                        CMP AL, 32h         ; Make M
   155 000000BE 7503                        JNE continua_reseta_m
   156 000000C0 E9F500                      JMP seta_m
   157                                  continua_reseta_m:
   158 000000C3 3CB2                        CMP AL, 0B2h        ; Break M
   159 000000C5 7503                        JNE continua_seta_n
   160 000000C7 E9F600                      JMP reseta_m
   161                                  
   162                                      ; CHUTES (Teclas N e R) 
   163                                  continua_seta_n:
   164 000000CA 3C31                        CMP AL, 31h         ; Make N
   165 000000CC 7503                        JNE continua_reseta_n
   166 000000CE E9F700                      JMP seta_n
   167                                  continua_reseta_n:
   168 000000D1 3CB1                        CMP AL, 0B1h        ; Break N
   169 000000D3 7503                        JNE continua_seta_r
   170 000000D5 E9F800                      JMP reseta_n
   171                                  continua_seta_r:
   172 000000D8 3C13                        CMP AL, 13h         ; Make R
   173 000000DA 7503                        JNE continua_reseta_r
   174 000000DC E9F900                      JMP seta_r
   175                                  continua_reseta_r:
   176 000000DF 3C93                        CMP AL, 93h         ; Break R
   177 000000E1 7503                        JNE continua_seta_q
   178 000000E3 E9FA00                      JMP reseta_r
   179                                  
   180                                      ; SAIR DO JOGO (Tecla Q) 
   181                                  continua_seta_q:
   182 000000E6 3C10                        CMP AL, 10h         ; Make Q
   183 000000E8 7503                        JNE continua_seta_w
   184 000000EA E9B300                      JMP seta_q
   185                                  
   186                                      ; PULOS E DEFESAS P1 (Teclas W e S) 
   187                                  continua_seta_w:
   188 000000ED 3C11                        CMP AL, 11h         ; Make W
   189 000000EF 7503                        JNE continua_reseta_w
   190 000000F1 E9F400                      JMP seta_w
   191                                  continua_reseta_w:
   192 000000F4 3C91                        CMP AL, 91h         ; Break W
   193 000000F6 7503                        JNE continua_seta_s
   194 000000F8 E9F500                      JMP reseta_w
   195                                  continua_seta_s:
   196 000000FB 3C1F                        CMP AL, 1Fh         ; Make S
   197 000000FD 7503                        JNE continua_reseta_s
   198 000000FF E9F600                      JMP seta_s
   199                                  continua_reseta_s:
   200 00000102 3C9F                        CMP AL, 9Fh         ; Break S
   201 00000104 7503                        JNE continua_seta_up
   202 00000106 E9F700                      JMP reseta_s
   203                                  
   204                                      ; PULOS E DEFESAS P2 (Setas Cima/Baixo e teclas I/K) 
   205                                  continua_seta_up:
   206 00000109 3C48                        CMP AL, 48h         ; Seta Cima (Make)
   207 0000010B 7503                        JNE continua_seta_up_i
   208 0000010D E9F800                      JMP seta_up
   209                                  continua_seta_up_i:
   210 00000110 3C17                        CMP AL, 17h         ; Tecla I (Make)
   211 00000112 7503                        JNE continua_reseta_up
   212 00000114 E9F100                      JMP seta_up
   213                                  continua_reseta_up:
   214 00000117 3CC8                        CMP AL, 0C8h        ; Seta Cima (Break)
   215 00000119 7503                        JNE continua_reseta_up_i
   216 0000011B E9F200                      JMP reseta_up
   217                                  continua_reseta_up_i:
   218 0000011E 3C97                        CMP AL, 97h         ; Tecla I (Break)
   219 00000120 7503                        JNE continua_seta_down
   220 00000122 E9EB00                      JMP reseta_up
   221                                  continua_seta_down:
   222 00000125 3C50                        CMP AL, 50h         ; Seta Baixo (Make)
   223 00000127 7503                        JNE continua_seta_down_k
   224 00000129 E9EC00                      JMP seta_down
   225                                  continua_seta_down_k:
   226 0000012C 3C25                        CMP AL, 25h         ; Tecla K (Make)
   227 0000012E 7503                        JNE continua_reseta_down
   228 00000130 E9E500                      JMP seta_down
   229                                  continua_reseta_down:
   230 00000133 3CD0                        CMP AL, 0D0h        ; Seta Baixo (Break)
   231 00000135 7503                        JNE continua_reseta_down_k
   232 00000137 E9E600                      JMP reseta_down
   233                                  continua_reseta_down_k:
   234 0000013A 3CA5                        CMP AL, 0A5h        ; Tecla K (Break)
   235 0000013C 7503                        JNE continua_seta_enter           ; <-- 2. NOVO: Desvia para testar a tecla Enter
   236 0000013E E9DF00                      JMP reseta_down 
   237                                  
   238                                  continua_seta_enter:    ; TECLA ENTER (Scancode 1Ch / Break 9Ch)
   239 00000141 3C1C                        CMP AL, 1Ch         ; Scancode Make da tecla Enter (Pressionada)
   240 00000143 7503                        JNE continua_reseta_enter
   241 00000145 E9E000                      JMP seta_enter
   242                                  continua_reseta_enter:
   243 00000148 3C9C                        CMP AL, 9Ch         ; Scancode Break da tecla Enter (Solta)
   244 0000014A 7503                        JNE continua_seta_y
   245 0000014C E9E100                      JMP reseta_enter
   246                                  continua_seta_y:        ; TECLA Y (Scancode Make 15h / Break 95h)
   247 0000014F 3C15                        CMP AL, 15h         ; Scancode Make da tecla Y (Pressionada)
   248 00000151 7503                        JNE continua_reseta_y
   249 00000153 E9E200                      JMP seta_y
   250                                  continua_reseta_y:
   251 00000156 3C95                        CMP AL, 95h         ; Scancode Break da tecla Y (Solta)
   252 00000158 7503                        JNE continua_final  ; Ou desvia para a próxima verificação (ex: continua_seta_enter)
   253 0000015A E9E300                      JMP reseta_y
   254                                  continua_final:
   255 0000015D E9E800                      JMP fim_int9
   256                                  
   257                                  ; MANIPULADORES DE ESTADO DAS TECLAS (FLAGS)
   258                                  seta_a:      
   259 00000160 C606[0000]01                MOV byte [key_a], 1
   260 00000165 E9E000                      JMP fim_int9
   261                                  reseta_a:     
   262 00000168 C606[0000]00                MOV byte [key_a], 0
   263 0000016D E9D800                      JMP fim_int9
   264                                  seta_d:       
   265 00000170 C606[0100]01                MOV byte [key_d], 1
   266 00000175 E9D000                      JMP fim_int9
   267                                  reseta_d:     
   268 00000178 C606[0100]00                MOV byte [key_d], 0
   269 0000017D E9C800                      JMP fim_int9
   270                                  seta_left:    
   271 00000180 C606[0200]01                MOV byte [key_left], 1
   272 00000185 E9C000                      JMP fim_int9
   273                                  reseta_left:  
   274 00000188 C606[0200]00                MOV byte [key_left], 0
   275 0000018D E9B800                      JMP fim_int9
   276                                  seta_right:   
   277 00000190 C606[0300]01                MOV byte [key_right], 1
   278 00000195 E9B000                      JMP fim_int9
   279                                  reseta_right: 
   280 00000198 C606[0300]00                MOV byte [key_right], 0
   281 0000019D E9A800                      JMP fim_int9
   282                                  seta_q:       
   283 000001A0 C606[0400]01                MOV byte [key_q], 1
   284 000001A5 E9A000                      JMP fim_int9
   285                                  seta_t:       
   286 000001A8 C606[0500]01                MOV byte [key_t], 1
   287 000001AD E99800                      JMP fim_int9
   288                                  reseta_t:     
   289 000001B0 C606[0500]00                MOV byte [key_t], 0
   290 000001B5 E99000                      JMP fim_int9
   291                                  seta_m:       
   292 000001B8 C606[0600]01                MOV byte [key_m], 1
   293 000001BD E98800                      JMP fim_int9
   294                                  reseta_m:     
   295 000001C0 C606[0600]00                MOV byte [key_m], 0
   296 000001C5 E98000                      JMP fim_int9
   297                                  seta_n:       
   298 000001C8 C606[0700]01                MOV byte [key_n], 1
   299 000001CD E97800                      JMP fim_int9
   300                                  reseta_n:     
   301 000001D0 C606[0700]00                MOV byte [key_n], 0
   302 000001D5 E97000                      JMP fim_int9
   303                                  seta_r:       
   304 000001D8 C606[0800]01                MOV byte [key_r], 1
   305 000001DD E96800                      JMP fim_int9
   306                                  reseta_r:     
   307 000001E0 C606[0800]00                MOV byte [key_r], 0
   308 000001E5 E96000                      JMP fim_int9
   309                                  seta_w:       
   310 000001E8 C606[0900]01                MOV byte [key_w], 1
   311 000001ED E95800                      JMP fim_int9
   312                                  reseta_w:     
   313 000001F0 C606[0900]00                MOV byte [key_w], 0
   314 000001F5 E95000                      JMP fim_int9
   315                                  seta_s:       
   316 000001F8 C606[0A00]01                MOV byte [key_s], 1
   317 000001FD E94800                      JMP fim_int9
   318                                  reseta_s:     
   319 00000200 C606[0A00]00                MOV byte [key_s], 0
   320 00000205 E94000                      JMP fim_int9
   321                                  seta_up:      
   322 00000208 C606[0B00]01                MOV byte [key_up], 1
   323 0000020D E93800                      JMP fim_int9
   324                                  reseta_up:    
   325 00000210 C606[0B00]00                MOV byte [key_up], 0
   326 00000215 E93000                      JMP fim_int9
   327                                  seta_down:    
   328 00000218 C606[0C00]01                MOV byte [key_down], 1
   329 0000021D E92800                      JMP fim_int9
   330                                  reseta_down:  
   331 00000220 C606[0C00]00                MOV byte [key_down], 0
   332 00000225 E92000                      JMP fim_int9
   333                                  seta_enter:
   334 00000228 C606[0D00]01                MOV byte [key_enter], 1
   335 0000022D E91800                      JMP fim_int9
   336                                  reseta_enter:
   337 00000230 C606[0D00]00                MOV byte [key_enter], 0
   338 00000235 E91000                      JMP fim_int9
   339                                  seta_y:
   340 00000238 C606[0E00]01                MOV byte [key_y], 1
   341 0000023D E90800                      JMP fim_int9
   342                                  reseta_y:
   343 00000240 C606[0E00]00                MOV byte [key_y], 0
   344 00000245 E90000                      JMP fim_int9
   345                                  
   346                                  ; FIM DA INTERRUPÇÃO
   347                                  fim_int9:
   348 00000248 E461                        IN AL, 61h
   349 0000024A 0C80                        OR AL, 80h
   350 0000024C E661                        OUT 61h, AL
   351 0000024E 247F                        AND AL, 7Fh
   352 00000250 E661                        OUT 61h, AL
   353 00000252 B020                        MOV AL, 20h
   354 00000254 E620                        OUT 20h, AL
   355 00000256 1F                          POP DS
   356 00000257 58                          POP AX
   357 00000258 CF                          IRET
