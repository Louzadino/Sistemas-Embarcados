     1                                  ; =====================================================================
     2                                  ; ARQUIVO: main.asm
     3                                  ; OBJETIVO: Loop principal do Jogo de Luta e controle de video
     4                                  ; =====================================================================
     5                                  
     6                                  segment code
     7                                  ..start:
     8                                      ; Declarando que vamos usar as funcoes graficas de outro arquivo (linec.asm)
     9                                      extern plot_xy
    10                                      extern line
    11                                      extern circle
    12                                      extern full_circle
    13                                      
    14                                      ; Declarando que vamos usar a variavel global de cor definida no linec.asm
    15                                      extern cor
    16                                  
    17                                      ; 1. Inicializacao dos registradores de segmento
    18 00000000 B8[0000]                    MOV AX, data
    19 00000003 8ED8                        MOV DS, AX
    20 00000005 B8[0000]                    MOV AX, stack
    21 00000008 8ED0                        MOV SS, AX
    22 0000000A BC[0002]                    MOV SP, stacktop
    23                                  
    24                                      ; 2. Salvar modo corrente de video (para nao bugar o DOSBox ao sair)
    25 0000000D B40F                        MOV AH, 0Fh
    26 0000000F CD10                        INT 10h
    27 00000011 A2[0000]                    MOV [modo_anterior], AL
    28                                  
    29                                      ; 3. Alterar modo de video para grafico VGA 640x480 16 cores
    30 00000014 B012                        MOV AL, 12h
    31 00000016 B400                        MOV AH, 0
    32 00000018 CD10                        INT 10h
    33                                  
    34                                      ; =================================================================
    35                                      ; TESTE DE DESENHO: O Chao da Arena
    36                                      ; =================================================================
    37 0000001A C606[0000]0F                MOV byte [cor], 15      ; 15 corresponde a branco intenso no Linec
    38                                  
    39                                      ; Passagem de parametros para desenhar a reta (y=400, x vai de 0 a 639)
    40 0000001F B80000                      MOV AX, 0
    41 00000022 50                          PUSH AX                 ; x1 = 0
    42 00000023 B89001                      MOV AX, 400
    43 00000026 50                          PUSH AX                 ; y1 = 400
    44 00000027 B87F02                      MOV AX, 639
    45 0000002A 50                          PUSH AX                 ; x2 = 639
    46 0000002B B89001                      MOV AX, 400
    47 0000002E 50                          PUSH AX                 ; y2 = 400
    48 0000002F E8(0000)                    CALL line               ; Chama a funcao do arquivo linec.asm
    49                                      ; =================================================================
    50                                  
    51                                  loop_principal:
    52                                      ; 4. Ler o teclado para manter o jogo rodando ate pedir para sair
    53                                      ; Nota: Estamos usando a INT 21h temporariamente apenas para este teste inicial.
    54                                      ; Mais tarde, o projeto exige que isso seja substituido pela INT 9h.
    55 00000032 B40B                        MOV AH, 0Bh
    56 00000034 CD21                        INT 21h                 ; Verifica o buffer do teclado
    57 00000036 3C00                        CMP AL, 0
    58 00000038 74F8                        JE loop_principal       ; Se for 0, nenhuma tecla foi pressionada, continua o loop
    59                                  
    60 0000003A B408                        MOV AH, 08h
    61 0000003C CD21                        INT 21h                 ; Le efetivamente o caracter digitado sem ecoar na tela
    62 0000003E 3C73                        CMP AL, 's'
    63 00000040 7407                        JE sair_jogo            ; Se for 's' minusculo, sai do jogo
    64 00000042 3C53                        CMP AL, 'S'
    65 00000044 7403                        JE sair_jogo            ; Se for 'S' maiusculo, sai do jogo
    66                                  
    67 00000046 E9E9FF                      JMP loop_principal      ; Se foi outra tecla, ignora e volta pro loop
    68                                  
    69                                  sair_jogo:
    70                                      ; 5. Restaurar o modo de video anterior do sistema
    71 00000049 B400                        MOV AH, 0   
    72 0000004B A0[0000]                    MOV AL, [modo_anterior] 
    73 0000004E CD10                        INT 10h
    74                                  
    75                                      ; 6. Encerrar o programa devolvendo o controle ao DOS
    76 00000050 B8004C                      MOV AX, 4C00h
    77 00000053 CD21                        INT 21h
    78                                  
    79                                  ; =====================================================================
    80                                  ; SEGMENTO DE DADOS
    81                                  ; =====================================================================
    82                                  segment data
    83 00000000 00                          modo_anterior db 0
    84                                  
    85                                  ; =====================================================================
    86                                  ; SEGMENTO DE PILHA
    87                                  ; =====================================================================
    88                                  segment stack stack
    89 00000000 <res 00000200>              resb 512
    90                                  stacktop:
