     1                                  ; ARQUIVO: main.asm
     2                                  ; OBJETIVO: Loop principal do Jogo de Luta e controle de video
     3                                  
     4                                  segment code
     5                                  ..start:
     6                                      ; Declarando que vamos usar as funcoes graficas de outro arquivo
     7                                      extern plot_xy
     8                                      extern line
     9                                      extern circle
    10                                      extern full_circle
    11                                      extern desenha_cenario      ; Importando a sua nova funcao
    12                                      
    13                                      extern cor
    14                                  
    15                                      ; 1. Inicializacao dos registradores de segmento
    16 00000000 B8[0000]                    MOV AX, data
    17 00000003 8ED8                        MOV DS, AX
    18 00000005 B8[0000]                    MOV AX, stack
    19 00000008 8ED0                        MOV SS, AX
    20 0000000A BC[0002]                    MOV SP, stacktop
    21                                  
    22                                      ; 2. Salvar modo corrente de video
    23 0000000D B40F                        MOV AH, 0Fh
    24 0000000F CD10                        INT 10h
    25 00000011 A2[0000]                    MOV [modo_anterior], AL
    26                                  
    27                                      ; 3. Alterar modo de video para grafico VGA 640x480 16 cores
    28 00000014 B012                        MOV AL, 12h
    29 00000016 B400                        MOV AH, 0
    30 00000018 CD10                        INT 10h
    31                                  
    32                                      ; DESENHO DO CENARIO E LUTADORES
    33 0000001A E8(0000)                    CALL desenha_cenario        ; Agora sim! Desenha a arena antes de entrar no loop
    34                                  
    35                                  loop_principal:
    36                                      ; 4. Ler o teclado para manter o jogo rodando
    37 0000001D B40B                        MOV AH, 0Bh
    38 0000001F CD21                        INT 21h                 ; Verifica o buffer do teclado
    39 00000021 3C00                        CMP AL, 0
    40 00000023 74F8                        JE loop_principal       ; Se for 0, nenhuma tecla foi pressionada, continua o loop
    41                                  
    42 00000025 B408                        MOV AH, 08h
    43 00000027 CD21                        INT 21h                 ; Le efetivamente o caracter digitado sem ecoar na tela
    44 00000029 3C73                        CMP AL, 's'
    45 0000002B 7407                        JE sair_jogo            ; Se for 's' minusculo, sai do jogo
    46 0000002D 3C53                        CMP AL, 'S'
    47 0000002F 7403                        JE sair_jogo            ; Se for 'S' maiusculo, sai do jogo
    48                                  
    49 00000031 E9E9FF                      JMP loop_principal      ; Se foi outra tecla, ignora e volta pro loop
    50                                  
    51                                  sair_jogo:
    52                                      ; 5. Restaurar o modo de video anterior do sistema
    53 00000034 B400                        MOV AH, 0   
    54 00000036 A0[0000]                    MOV AL, [modo_anterior] 
    55 00000039 CD10                        INT 10h
    56                                  
    57                                      ; 6. Encerrar o programa devolvendo o controle ao DOS
    58 0000003B B8004C                      MOV AX, 4C00h
    59 0000003E CD21                        INT 21h
    60                                  
    61                                  ; SEGMENTO DE DADOS
    62                                  segment data
    63 00000000 00                          modo_anterior db 0
    64                                  
    65                                  
    66                                  ; SEGMENTO DE PILHA
    67                                  segment stack stack
    68 00000000 <res 00000200>              resb 512
    69                                  stacktop:
