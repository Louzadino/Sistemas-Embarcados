     1                                  ; OBJETIVO: Loop principal do jogo e controle de video
     2                                  
     3                                  segment code
     4                                  ..start:
     5                                      ; Declarando que vamos usar as funcoes graficas de outro arquivo
     6                                      extern plot_xy
     7                                      extern line
     8                                      extern circle
     9                                      extern full_circle
    10                                      extern desenha_cenario      
    11                                      extern desenha_lutadores
    12                                      
    13                                      extern cor
    14                                  
    15                                      ; Inicializacao dos registradores de segmento
    16 00000000 B8[0000]                    MOV AX, data
    17 00000003 8ED8                        MOV DS, AX
    18 00000005 B8[0000]                    MOV AX, stack
    19 00000008 8ED0                        MOV SS, AX
    20 0000000A BC[0002]                    MOV SP, stacktop
    21                                  
    22                                      ; Salvar modo corrente de video
    23 0000000D B40F                        MOV AH, 0Fh
    24 0000000F CD10                        INT 10h
    25 00000011 A2[0000]                    MOV [modo_anterior], AL
    26                                  
    27                                      ; Alterar modo de video para grafico VGA 640x480 16 cores
    28 00000014 B012                        MOV AL, 12h
    29 00000016 B400                        MOV AH, 0
    30 00000018 CD10                        INT 10h
    31                                  
    32                                      ; DESENHO DO CENARIO E LUTADORES
    33 0000001A E8(0000)                    CALL desenha_cenario        ; Desenha a arena antes de entrar no loop
    34 0000001D E8(0000)                    CALL desenha_lutadores      ; Também desenha os lutadores
    35                                  
    36                                  loop_principal:
    37                                      ; Ler o teclado para manter o jogo rodando
    38 00000020 B40B                        MOV AH, 0Bh
    39 00000022 CD21                        INT 21h                 ; Verifica o buffer do teclado
    40 00000024 3C00                        CMP AL, 0
    41 00000026 74F8                        JE loop_principal       ; Se for 0, nenhuma tecla foi pressionada, continua o loop
    42                                  
    43 00000028 B408                        MOV AH, 08h
    44 0000002A CD21                        INT 21h                 ; Le efetivamente o caracter digitado sem ecoar na tela
    45 0000002C 3C71                        CMP AL, 'q'
    46 0000002E 7407                        JE sair_jogo            ; Se for 's' minusculo, sai do jogo
    47 00000030 3C51                        CMP AL, 'Q'
    48 00000032 7403                        JE sair_jogo            ; Se for 'S' maiusculo, sai do jogo
    49                                  
    50 00000034 E9E9FF                      JMP loop_principal      ; Se foi outra tecla, ignora e volta pro loop
    51                                  
    52                                  sair_jogo:
    53                                      ; Restaurar o modo de video anterior do sistema
    54 00000037 B400                        MOV AH, 0   
    55 00000039 A0[0000]                    MOV AL, [modo_anterior] 
    56 0000003C CD10                        INT 10h
    57                                  
    58                                      ; Encerrar o programa devolvendo o controle ao DOS
    59 0000003E B8004C                      MOV AX, 4C00h
    60 00000041 CD21                        INT 21h
    61                                  
    62                                  ; SEGMENTO DE DADOS
    63                                  segment data
    64 00000000 00                          modo_anterior db 0
    65                                  
    66                                  
    67                                  ; SEGMENTO DE PILHA
    68                                  segment stack stack
    69 00000000 <res 00000200>              resb 512
    70                                  stacktop:
