     1                                  ; OBJETIVO: Desenhar a arena de luta, limites e HUD
     2                                  
     3                                  segment code
     4                                      global desenha_cenario      ; Torna a funcao visivel para o main.asm
     5                                      
     6                                      extern line                 ; Importa a funcao de desenhar reta do linec.asm
     7                                      extern cor                  ; Importa a variavel global de cor do linec.asm
     8                                  
     9                                  desenha_cenario:
    10                                      ; Salva o contexto na pilha (boa pratica para nao corromper registradores)
    11 00000000 55                          PUSH BP
    12 00000001 89E5                        MOV BP, SP
    13 00000003 50                          PUSH AX
    14                                  
    15                                      ; Define a cor dos delimitadores como branco intenso (15)
    16 00000004 C606[0000]0F                MOV byte [cor], 15
    17                                  
    18                                      ; 1. Desenhar o Chao (Y=50, indo de X=0 ate X=639)
    19 00000009 B80000                      MOV AX, 0
    20 0000000C 50                          PUSH AX
    21 0000000D B83200                      MOV AX, 50
    22 00000010 50                          PUSH AX
    23 00000011 B87F02                      MOV AX, 639
    24 00000014 50                          PUSH AX
    25 00000015 B83200                      MOV AX, 50
    26 00000018 50                          PUSH AX
    27 00000019 E8(0000)                    CALL line
    28                                  
    29                                      ; 2. Desenhar o Teto (Y=400, indo de X=0 ate X=639)
    30 0000001C B80000                      MOV AX, 0
    31 0000001F 50                          PUSH AX
    32 00000020 B89001                      MOV AX, 400
    33 00000023 50                          PUSH AX
    34 00000024 B87F02                      MOV AX, 639
    35 00000027 50                          PUSH AX
    36 00000028 B89001                      MOV AX, 400
    37 0000002B 50                          PUSH AX
    38 0000002C E8(0000)                    CALL line
    39                                  
    40                                      ; 3. Desenhar Limite Esquerdo (X=5, indo de Y=50 ate Y=400)
    41 0000002F B80500                      MOV AX, 5
    42 00000032 50                          PUSH AX
    43 00000033 B83200                      MOV AX, 50
    44 00000036 50                          PUSH AX
    45 00000037 B80500                      MOV AX, 5
    46 0000003A 50                          PUSH AX
    47 0000003B B89001                      MOV AX, 400
    48 0000003E 50                          PUSH AX
    49 0000003F E8(0000)                    CALL line
    50                                  
    51                                      ; 4. Desenhar Limite Direito (X=634, indo de Y=50 ate Y=400)
    52 00000042 B87A02                      MOV AX, 634
    53 00000045 50                          PUSH AX
    54 00000046 B83200                      MOV AX, 50
    55 00000049 50                          PUSH AX
    56 0000004A B87A02                      MOV AX, 634
    57 0000004D 50                          PUSH AX
    58 0000004E B89001                      MOV AX, 400
    59 00000051 50                          PUSH AX
    60 00000052 E8(0000)                    CALL line
    61                                  
    62                                      ; Restaura o contexto e retorna
    63 00000055 58                          POP AX
    64 00000056 5D                          POP BP
    65 00000057 C3                          RET
