     1                                  ; RESUMO: Módulo gráfico responsável pela renderização dos lutadores e 
     2                                  ; gerenciamento de suas posições e cores na arena. Utiliza macros do 
     3                                  ; NASM para desenhar linhas e círculos de forma compacta, cobrindo todas 
     4                                  ; as poses (normal, passos, agachado, soco e chute) para ambos os jogadores.
     5                                  
     6                                  segment data
     7                                      global p1_x, p1_y, p2_x, p2_y
     8                                      
     9                                      ; Importa as cores que foram atualizadas pelo menu_inicial.asm
    10                                      extern cor_p1, cor_p2
    11                                      
    12                                      ; Coordenadas iniciais dos lutadores na tela
    13 00000000 9600                        p1_x dw 150
    14 00000002 7300                        p1_y dw 115
    15 00000004 EA01                        p2_x dw 490
    16 00000006 7300                        p2_y dw 115
    17                                      
    18                                  segment code
    19                                      global desenha_lutadores, apaga_lutadores
    20                                      global desenha_p1_normal, desenha_p2_normal
    21                                      global desenha_p1_agachado, desenha_p2_agachado
    22                                      global desenha_p1_andando, desenha_p2_andando
    23                                      global desenha_soco_p1, desenha_soco_p2
    24                                      global desenha_chute_p1, desenha_chute_p2
    25                                      
    26                                      extern line, circle, cor
    27                                  
    28                                  ; MACROS DE DESENHO GEOMETRICO
    29                                  ; Simplificam a chamada das funções de primitivas gráficas por deslocamento
    30                                  
    31                                  ; Macro para desenhar linhas relativas à base (X, Y)
    32                                  ; Parâmetros: %1=BaseX, %2=OffsetX1, %3=BaseY, %4=OffsetY1, %5=OffsetX2, %6=OffsetY2
    33                                  %macro LINE 6
    34                                      MOV AX, %1
    35                                      ADD AX, %2
    36                                      PUSH AX
    37                                      MOV AX, %3
    38                                      ADD AX, %4
    39                                      PUSH AX
    40                                      MOV AX, %1
    41                                      ADD AX, %5
    42                                      PUSH AX
    43                                      MOV AX, %3
    44                                      ADD AX, %6
    45                                      PUSH AX
    46                                      CALL line
    47                                  %endmacro
    48                                  
    49                                  ; Macro para desenhar a cabeça (círculo com raio fixo de 10 pixels)
    50                                  ; Parâmetros: %1=BaseX, %2=OffsetX, %3=BaseY, %4=OffsetY
    51                                  %macro CIRCLE 4
    52                                      MOV AX, %1
    53                                      ADD AX, %2
    54                                      PUSH AX
    55                                      MOV AX, %3
    56                                      ADD AX, %4
    57                                      PUSH AX
    58                                      MOV AX, 10
    59                                      PUSH AX
    60                                      CALL circle
    61                                  %endmacro
    62                                  
    63                                  desenha_lutadores:
    64 00000000 E80400                      CALL desenha_p1_normal
    65 00000003 E8FC00                      CALL desenha_p2_normal
    66 00000006 C3                          RET
