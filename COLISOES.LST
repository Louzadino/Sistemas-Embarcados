     1                                  ; =====================================================================
     2                                  ; ARQUIVO: colisoes.asm
     3                                  ; RESUMO: Módulo responsável por gerenciar o sistema de combate do jogo.
     4                                  ; Valida as teclas de ataque (socos e chutes), verifica se há colisão 
     5                                  ; ou distância válida entre os jogadores, processa a redução de energia,
     6                                  ; atualiza a HUD e implementa travas para evitar dano contínuo por pressão.
     7                                  ; =====================================================================
     8                                  
     9                                  segment data
    10                                      global soco_p1_travado, soco_p2_travado
    11                                      global chute_p1_travado, chute_p2_travado
    12                                  
    13                                      ; Flags de trava de golpe (evitam que manter a tecla pressionada cause múltiplos danos seguidos)
    14 00000000 00                          soco_p1_travado db 0
    15 00000001 00                          soco_p2_travado db 0
    16 00000002 00                          chute_p1_travado db 0
    17 00000003 00                          chute_p2_travado db 0
    18                                  
    19                                  segment code
    20                                      global verifica_ataques
    21                                      
    22                                      extern p1_x, p1_y, p2_x, p2_y
    23                                      extern p1_estado, p2_estado
    24                                      extern energia_p1, energia_p2
    25                                      extern status_jogadores
    26                                      
    27                                      extern key_t, key_m, key_n, key_r
    28                                      
    29                                      extern apaga_lutadores, desenha_cenario
    30                                      extern desenha_soco_p1, desenha_soco_p2
    31                                      extern desenha_chute_p1, desenha_chute_p2
    32                                      extern render_p1, render_p2
    33                                  
    34                                  ; ==================================================
    35                                  ; FUNÇÃO CENTRAL: VERIFICA_ATAQUES
    36                                  ; Chama sequencialmente a verificação de golpes para ambos os jogadores
    37                                  ; ==================================================
    38                                  verifica_ataques:
    39 00000000 50                          PUSH AX
    40 00000001 E80B00                      CALL verifica_soco_p1
    41 00000004 E85800                      CALL verifica_chute_p1
    42 00000007 E89E00                      CALL verifica_soco_p2
    43 0000000A E8EB00                      CALL verifica_chute_p2
    44 0000000D 58                          POP AX
    45 0000000E C3                          RET
    46                                  
    47                                  ; ==================================================
    48                                  ; ROTINA: SOCO DO PLAYER 1 (Tecla T)
    49                                  ; ==================================================
    50                                  verifica_soco_p1:
    51 0000000F 803E[0000]01                CMP byte [key_t], 1             ; Verifica se a tecla T está pressionada
    52 00000014 7543                        JNE reseta_soco_p1              ; Se não estiver, reseta a trava do soco
    53                                      
    54                                      ; Desenha temporariamente o frame de soco do P1 na tela
    55 00000016 E8(0000)                    CALL apaga_lutadores
    56 00000019 E8(0000)                    CALL desenha_soco_p1
    57 0000001C E8(0000)                    CALL render_p2      
    58 0000001F E8(0000)                    CALL desenha_cenario
    59                                  
    60 00000022 803E[0000]01                CMP byte [soco_p1_travado], 1   ; Se o golpe já foi contabilizado nesta pressão, ignora
    61 00000027 742F                        JE fim_soco_p1
    62                                      
    63 00000029 C606[0000]01                MOV byte [soco_p1_travado], 1   ; Ativa a trava para registrar apenas um hit por toque
    64                                      
    65                                      ; Cálculo da distância horizontal entre P1 e P2 (AX = p2_x - p1_x)
    66 0000002E A1[0000]                    MOV AX, [p2_x]
    67 00000031 2B06[0000]                  SUB AX, [p1_x]
    68 00000035 3D2D00                      CMP AX, 45                      ; Verifica se está dentro do alcance do soco (<= 45 pixels)
    69 00000038 7F1E                        JG fim_soco_p1
    70                                      
    71                                      ; Validação de Defesa (se o P2 estiver pulando no ar ou agachado, o golpe falha)
    72 0000003A 813E[0000]7300              CMP word [p2_y], 115
    73 00000040 7F16                        JG fim_soco_p1                  ; P2 está no ar (pulando)
    74 00000042 803E[0000]01                CMP byte [p2_estado], 1
    75 00000047 740F                        JE fim_soco_p1                  ; P2 está agachado
    76                                  
    77                                      ; Validação e Aplicação do Dano no P2
    78 00000049 813E[0000]0000              CMP word [energia_p2], 0
    79 0000004F 7407                        JE fim_soco_p1                  ; Se já estiver sem energia, não faz nada
    80 00000051 FF0E[0000]                  DEC word [energia_p2]           ; Reduz 1 unidade de energia do P2
    81 00000055 E8(0000)                    CALL status_jogadores           ; Atualiza a barra de energia na tela (HUD)
    82                                  fim_soco_p1:
    83 00000058 C3                          RET
    84                                  reseta_soco_p1:
    85 00000059 C606[0000]00                MOV byte [soco_p1_travado], 0   ; Libera a trava quando a tecla é solta
    86 0000005E C3                          RET
    87                                  
    88                                  ; ==================================================
    89                                  ; ROTINA: CHUTE DO PLAYER 1 (Tecla R)
    90                                  ; ==================================================
    91                                  verifica_chute_p1:
    92 0000005F 803E[0000]01                CMP byte [key_r], 1             ; Verifica se a tecla R está pressionada
    93 00000064 753C                        JNE reseta_chute_p1
    94                                      
    95 00000066 E8(0000)                    CALL apaga_lutadores
    96 00000069 E8(0000)                    CALL desenha_chute_p1
    97 0000006C E8(0000)                    CALL render_p2      
    98 0000006F E8(0000)                    CALL desenha_cenario
    99                                  
   100 00000072 803E[0200]01                CMP byte [chute_p1_travado], 1
   101 00000077 7428                        JE fim_chute_p1
   102                                      
   103 00000079 C606[0200]01                MOV byte [chute_p1_travado], 1 
   104                                      
   105                                      ; Verifica alcance horizontal
   106 0000007E A1[0000]                    MOV AX, [p2_x]
   107 00000081 2B06[0000]                  SUB AX, [p1_x]
   108 00000085 3D2D00                      CMP AX, 45
   109 00000088 7F17                        JG fim_chute_p1
   110                                      
   111                                      ; Verifica se P2 está defendendo (no ar)
   112 0000008A 813E[0000]7300              CMP word [p2_y], 115
   113 00000090 7F0F                        JG fim_chute_p1
   114                                  
   115                                      ; Aplica dano caso passe pelas validações
   116 00000092 813E[0000]0000              CMP word [energia_p2], 0
   117 00000098 7407                        JE fim_chute_p1
   118 0000009A FF0E[0000]                  DEC word [energia_p2]
   119 0000009E E8(0000)                    CALL status_jogadores
   120                                  fim_chute_p1:
   121 000000A1 C3                          RET
   122                                  reseta_chute_p1:
   123 000000A2 C606[0200]00                MOV byte [chute_p1_travado], 0
   124 000000A7 C3                          RET
   125                                  
   126                                  ; ==================================================
   127                                  ; ROTINA: SOCO DO PLAYER 2 (Tecla M)
   128                                  ; ==================================================
   129                                  verifica_soco_p2:
   130 000000A8 803E[0000]01                CMP byte [key_m], 1             ; Verifica se a tecla M está pressionada
   131 000000AD 7543                        JNE reseta_soco_p2
   132                                      
   133 000000AF E8(0000)                    CALL apaga_lutadores
   134 000000B2 E8(0000)                    CALL render_p1      
   135 000000B5 E8(0000)                    CALL desenha_soco_p2
   136 000000B8 E8(0000)                    CALL desenha_cenario
   137                                  
   138 000000BB 803E[0100]01                CMP byte [soco_p2_travado], 1
   139 000000C0 742F                        JE fim_soco_p2
   140                                      
   141 000000C2 C606[0100]01                MOV byte [soco_p2_travado], 1 
   142                                      
   143                                      ; Distância horizontal para o P2
   144 000000C7 A1[0000]                    MOV AX, [p2_x]
   145 000000CA 2B06[0000]                  SUB AX, [p1_x]
   146 000000CE 3D2D00                      CMP AX, 45
   147 000000D1 7F1E                        JG fim_soco_p2
   148                                  
   149                                      ; Verifica se o P1 está defendendo (no ar ou agachado)
   150 000000D3 813E[0000]7300              CMP word [p1_y], 115
   151 000000D9 7F16                        JG fim_soco_p2
   152 000000DB 803E[0000]01                CMP byte [p1_estado], 1
   153 000000E0 740F                        JE fim_soco_p2
   154                                  
   155                                      ; Aplica dano no P1
   156 000000E2 813E[0000]0000              CMP word [energia_p1], 0
   157 000000E8 7407                        JE fim_soco_p2
   158 000000EA FF0E[0000]                  DEC word [energia_p1]
   159 000000EE E8(0000)                    CALL status_jogadores
   160                                  fim_soco_p2:
   161 000000F1 C3                          RET
   162                                  reseta_soco_p2:
   163 000000F2 C606[0100]00                MOV byte [soco_p2_travado], 0
   164 000000F7 C3                          RET
   165                                  
   166                                  ; ==================================================
   167                                  ; ROTINA: CHUTE DO PLAYER 2 (Tecla N)
   168                                  ; ==================================================
   169                                  verifica_chute_p2:
   170 000000F8 803E[0000]01                CMP byte [key_n], 1             ; Verifica se a tecla N está pressionada
   171 000000FD 753C                        JNE reseta_chute_p2
   172                                      
   173 000000FF E8(0000)                    CALL apaga_lutadores
   174 00000102 E8(0000)                    CALL render_p1      
   175 00000105 E8(0000)                    CALL desenha_chute_p2
   176 00000108 E8(0000)                    CALL desenha_cenario
   177                                  
   178 0000010B 803E[0300]01                CMP byte [chute_p2_travado], 1
   179 00000110 7428                        JE fim_chute_p2
   180                                      
   181 00000112 C606[0300]01                MOV byte [chute_p2_travado], 1 
   182                                      
   183 00000117 A1[0000]                    MOV AX, [p2_x]
   184 0000011A 2B06[0000]                  SUB AX, [p1_x]
   185 0000011E 3D2D00                      CMP AX, 45
   186 00000121 7F17                        JG fim_chute_p2
   187                                      
   188 00000123 813E[0000]7300              CMP word [p1_y], 115
   189 00000129 7F0F                        JG fim_chute_p2
   190                                  
   191 0000012B 813E[0000]0000              CMP word [energia_p1], 0
   192 00000131 7407                        JE fim_chute_p2
   193 00000133 FF0E[0000]                  DEC word [energia_p1]
   194 00000137 E8(0000)                    CALL status_jogadores
   195                                  fim_chute_p2:
   196 0000013A C3                          RET
   197                                  reseta_chute_p2:
   198 0000013B C606[0300]00                MOV byte [chute_p2_travado], 0
   199 00000140 C3                          RET
