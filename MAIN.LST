     1                                  ; =====================================================================
     2                                  ; ARQUIVO: main.asm  (versão corrigida)
     3                                  ; RESUMO: Módulo principal do jogo de luta em Assembly x86 16-bit.
     4                                  ; Orquestra a inicialização do vídeo VGA 12h, a seleção de cores,
     5                                  ; o ciclo fixo de 3 rounds (ini_round -> round -> end_round),
     6                                  ; a pausa/confirmação de saída e o encerramento seguro.
     7                                  ; =====================================================================
     8                                  
     9                                  segment code
    10                                      ; Hardware e menus
    11                                      extern instala_teclado, restaura_teclado
    12                                      extern MENU_INICIAL
    13                                  
    14                                      ; Módulos de rounds e pausa
    15                                      extern ini_round, round, end_round, game_over
    16                                      extern reset_timer
    17                                  
    18                                      ; Variáveis globais de estado
    19                                      extern energia_p1, energia_p2, round_retomando
    20                                  
    21                                  ..start:
    22                                      ; -------------------------------------------------------------
    23                                      ; 1. INICIALIZAÇÃO DO SISTEMA E SEGMENTOS
    24                                      ; -------------------------------------------------------------
    25 00000000 B8[0000]                    MOV AX, data
    26 00000003 8ED8                        MOV DS, AX
    27                                  
    28 00000005 FA                          CLI                         ; troca de pilha sem interrupção no meio
    29 00000006 B8[0000]                    MOV AX, stack
    30 00000009 8ED0                        MOV SS, AX
    31 0000000B BC[0008]                    MOV SP, stacktop
    32 0000000E FB                          STI
    33                                  
    34                                      ; Instala a rotina customizada da interrupção de teclado (INT 9h)
    35 0000000F E8(0000)                    CALL instala_teclado
    36                                  
    37                                      ; Salva o modo de vídeo atual e configura o Modo Gráfico VGA 640x480 (12h)
    38 00000012 B40F                        MOV AH, 0Fh
    39 00000014 CD10                        INT 10h
    40 00000016 247F                        AND AL, 7Fh                 ; descarta o bit 7 (flag "não limpar tela")
    41 00000018 A2[0000]                    MOV [modo_anterior], AL
    42 0000001B B81200                      MOV AX, 0012h
    43 0000001E CD10                        INT 10h
    44                                  
    45                                      ; -------------------------------------------------------------
    46                                      ; 2. MENU INICIAL DE SELEÇÃO DE CORES
    47                                      ;    (o primeiro frame é desenhado por ini_round)
    48                                      ; -------------------------------------------------------------
    49 00000020 E8(0000)                    CALL MENU_INICIAL
    50                                  
    51 00000023 C706[0100]0100              MOV word [numero_do_round], 1
    52                                  
    53                                  ; =====================================================================
    54                                  ; 3. LAÇO DOS 3 ROUNDS DA PARTIDA
    55                                  ; =====================================================================
    56                                  loop_partida:
    57                                      ; --- A. PREPARAÇÃO DO ROUND NOVO ---
    58 00000029 C706[0000]0A00              MOV word [energia_p1], 10
    59 0000002F C706[0000]0A00              MOV word [energia_p2], 10
    60 00000035 C706[0000]0000              MOV word [round_retomando], 0
    61 0000003B E8(0000)                    CALL reset_timer            ; HUD já mostra 03:00 durante a contagem
    62                                  
    63                                      ; --- B. ANIMAÇÃO DE INÍCIO (3... 2... 1... ROUND N!) ---
    64 0000003E A1[0100]                    MOV AX, [numero_do_round]
    65 00000041 E8(0000)                    CALL ini_round
    66                                  
    67                                  executa_combate:
    68                                      ; --- C. COMBATE ATIVO ---
    69 00000044 E8(0000)                    CALL round                  ; AX: 0 = Empate, 1 = P1, 2 = P2, 3 = Tecla Q
    70                                  
    71                                      ; --- D. TECLA Q (GAME OVER / PAUSA) ---
    72 00000047 3D0300                      CMP AX, 3
    73 0000004A 7417                        JE  trata_pausa
    74                                  
    75                                      ; --- E. FIM DO ROUND (stdcall, end_round limpa a pilha com RET 4) ---
    76 0000004C FF36[0100]                  PUSH word [numero_do_round] ; [BP+6]
    77 00000050 50                          PUSH AX                     ; [BP+4]
    78 00000051 E8(0000)                    CALL end_round
    79                                  
    80                                      ; --- F. FIM DOS 3 ROUNDS? ---
    81 00000054 813E[0100]0300              CMP word [numero_do_round], 3
    82 0000005A 7D18                        JGE encerra_jogo
    83                                  
    84 0000005C FF06[0100]                  INC word [numero_do_round]
    85 00000060 E9C6FF                      JMP loop_partida
    86                                  
    87                                  ; -------------------------------------------------------------
    88                                  ; TRATAMENTO DA TECLA Q (CONFIRMAÇÃO DE SAÍDA)
    89                                  ; -------------------------------------------------------------
    90                                  trata_pausa:
    91 00000063 E8(0000)                    CALL game_over              ; AX: 1 = Y (sair), 0 = N (cancelou)
    92 00000066 3D0100                      CMP AX, 1
    93 00000069 7409                        JE  encerra_jogo
    94                                  
    95 0000006B C706[0000]0100              MOV word [round_retomando], 1   ; retoma o round atual (tempo e energia mantidos)
    96 00000071 E9D0FF                      JMP executa_combate
    97                                  
    98                                  ; =====================================================================
    99                                  ; 4. ENCERRAMENTO E RESTAURAÇÃO DO SISTEMA
   100                                  ; =====================================================================
   101                                  encerra_jogo:
   102 00000074 E8(0000)                    CALL restaura_teclado       ; restaura a INT 9h original
   103 00000077 B400                        MOV AH, 0
   104 00000079 A0[0000]                    MOV AL, [modo_anterior]     ; restaura o modo de vídeo original (03h)
   105 0000007C CD10                        INT 10h
   106 0000007E B8004C                      MOV AX, 4C00h               ; volta ao DOS
   107 00000081 CD21                        INT 21h
   108                                  
   109                                  ; =====================================================================
   110                                  ; SEGMENTO DE DADOS E PILHA
   111                                  ; =====================================================================
   112                                  segment data
   113 00000000 00                          modo_anterior   db 0
   114 00000001 0100                        numero_do_round dw 1        ; contador de 1 a 3
   115                                  
   116                                  segment stack stack
   117 00000000 <res 00000800>              resb 2048
   118                                  stacktop:
