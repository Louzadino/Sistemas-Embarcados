     1                                  ; RESUMO: Arquivo principal do jogo de luta. É responsável por gerenciar
     2                                  ; a inicialização do sistema, configuração de vídeo, laço principal 
     3                                  ; (game loop), chamadas de renderização, física, colisões e encerramento.
     4                                  
     5                                  segment code
     6                                  ..start:
     7                                      ; Importação de funções gráficas e de cenário de outros módulos
     8                                      extern desenha_cenario, desenha_lutadores, apaga_lutadores
     9                                      extern desenha_p1_normal, desenha_p2_normal
    10                                      extern desenha_p1_agachado, desenha_p2_agachado
    11                                      extern desenha_p1_andando, desenha_p2_andando
    12                                  
    13                                      ; Importação de variáveis de status e posições
    14                                      extern status_jogadores
    15                                      extern energia_p1, energia_p2
    16                                      extern p1_x, p2_x, p1_y, p2_y
    17                                      
    18                                      ; Importação de estados e módulos externos (física e colisões)
    19                                      extern p1_estado, p2_estado
    20                                      extern atualiza_movimento
    21                                      extern verifica_ataques
    22                                  
    23                                      ; Importação de rotinas de hardware de teclado e teclas mapeadas
    24                                      extern instala_teclado, restaura_teclado
    25                                      extern key_q, key_a, key_d, key_left, key_right
    26                                  
    27                                      ; Importação da função de menu inicial (seleção de cores dos lutadores)
    28                                      extern MENU_INICIAL, cor_p1, cor_p2, cor
    29                                  
    30                                      ; Importação da função timer
    31                                      extern timer
    32                                  
    33                                      ; INICIALIZAÇÃO DO SISTEMA E VÍDEO
    34 00000000 B8[0000]                    MOV AX, data
    35 00000003 8ED8                        MOV DS, AX
    36 00000005 B8[0000]                    MOV AX, stack
    37 00000008 8ED0                        MOV SS, AX
    38 0000000A BC[0002]                    MOV SP, stacktop
    39                                  
    40                                      ; Instala a nova interrupção de teclado (INT 9h)
    41 0000000D E8(0000)                    CALL instala_teclado
    42                                  
    43                                      ; Salva o modo de vídeo atual e configura o modo gráfico 640x480 (16h / 12h)
    44 00000010 B40F                        MOV AH, 0Fh
    45 00000012 CD10                        INT 10h
    46 00000014 A2[0000]                    MOV [modo_anterior], AL
    47 00000017 B012                        MOV AL, 12h
    48 00000019 B400                        MOV AH, 0
    49 0000001B CD10                        INT 10h
    50                                  
    51                                      ; EXECUTA O MENU INTERATIVO DE SELEÇÃO DE CORES
    52                                      ; (Fica retido aqui até os dois jogadores escolherem as cores e apertarem ENTER)  
    53                                  
    54 0000001D E8(0000)                    CALL MENU_INICIAL
    55                                  
    56                                      ; Já presente nas suas funções de desenho do P1:
    57 00000020 A0[0000]                    MOV AL, [cor_p1]
    58 00000023 A2[0000]                    MOV byte [cor], AL
    59                                  
    60                                      ; Já presente nas suas funções de desenho do P2:
    61 00000026 A0[0000]                    MOV AL, [cor_p2]
    62 00000029 A2[0000]                    MOV byte [cor], AL
    63                                  
    64                                      ; Inicia o cenário e renderiza os lutadores já com as cores escolhidas em 'cor_p1' e 'cor_p2'
    65 0000002C E8(0000)                    CALL desenha_cenario
    66 0000002F E82E00                      CALL render_p1
    67 00000032 E85C00                      CALL render_p2
    68 00000035 E8(0000)                    CALL status_jogadores
    69                                  
    70                                      ; LAÇO PRINCIPAL DO JOGO (GAME LOOP)
    71                                  loop_principal:
    72 00000038 E89600                      CALL delay
    73                                  
    74                                      ; --- Correção do pulo de saída ---
    75 0000003B 803E[0000]01                CMP byte [key_q], 1
    76 00000040 7503                        JNE continua_game_loop
    77 00000042 E97D00                      JMP sair_jogo
    78                                  
    79                                  continua_game_loop:
    80                                      ; 1. Processa colisões e ataques
    81 00000045 E8(0000)                    CALL verifica_ataques
    82                                      
    83                                      ; 2. Apaga rastro e atualiza física
    84 00000048 E8(0000)                    CALL apaga_lutadores
    85 0000004B E8(0000)                    CALL atualiza_movimento
    86                                  
    87                                      ; 3. Renderiza o quadro atual
    88 0000004E E80F00                      CALL render_p1
    89 00000051 E83D00                      CALL render_p2
    90 00000054 E8(0000)                    CALL desenha_cenario 
    91                                      
    92 00000057 E8(0000)                    CALL timer
    93 0000005A 3D0100                      CMP AX, 1
    94                                      ;JE tempo_acabou            ; Se AX = 1 (retorno da função timer), encerra a partida    
    95 0000005D E9D8FF                      JMP loop_principal
    96                                  
    97                                  ; FUNÇÕES DE RENDERIZAÇÃO
    98                                  ; Decidem qual sprite do lutador desenhar com base 
    99                                  ; na física (se está pulando, agachando ou andando)
   100                                  global render_p1, render_p2
   101                                  
   102                                  render_p1:
   103 00000060 803E[0000]01                CMP byte [p1_estado], 1      ; Verifica se o P1 está agachado
   104 00000065 7426                        JE r_agachado_p1
   105 00000067 813E[0000]7300              CMP word [p1_y], 115         ; Verifica se o P1 está no ar (pulando)
   106 0000006D 7F0E                        JG r_normal_p1      
   107 0000006F 803E[0000]01                CMP byte [key_a], 1          ; Verifica se está andando para esquerda
   108 00000074 740B                        JE r_check_passo_p1
   109 00000076 803E[0000]01                CMP byte [key_d], 1          ; Verifica se está andando para direita
   110 0000007B 7404                        JE r_check_passo_p1
   111                                  r_normal_p1:
   112 0000007D E8(0000)                    CALL desenha_p1_normal       ; Desenha pose padrão em pé
   113 00000080 C3                          RET
   114                                  r_check_passo_p1:
   115 00000081 A1[0000]                    MOV AX, [p1_x]
   116 00000084 A91000                      TEST AX, 0010h               ; Alterna o sprite de passo baseando nos bits da posição X
   117 00000087 74F4                        JZ r_normal_p1
   118 00000089 E8(0000)                    CALL desenha_p1_andando      ; Desenha pose andando
   119 0000008C C3                          RET
   120                                  r_agachado_p1:
   121 0000008D E8(0000)                    CALL desenha_p1_agachado     ; Desenha pose agachada
   122 00000090 C3                          RET
   123                                  
   124                                  render_p2:
   125 00000091 803E[0000]01                CMP byte [p2_estado], 1      ; Verifica se o P2 está agachado
   126 00000096 7426                        JE r_agachado_p2
   127 00000098 813E[0000]7300              CMP word [p2_y], 115         ; Verifica se o P2 está no ar
   128 0000009E 7F0E                        JG r_normal_p2      
   129 000000A0 803E[0000]01                CMP byte [key_left], 1       ; Verifica se está andando para esquerda
   130 000000A5 740B                        JE r_check_passo_p2
   131 000000A7 803E[0000]01                CMP byte [key_right], 1      ; Verifica se está andando para direita
   132 000000AC 7404                        JE r_check_passo_p2
   133                                  r_normal_p2:
   134 000000AE E8(0000)                    CALL desenha_p2_normal       ; Desenha pose padrão em pé
   135 000000B1 C3                          RET
   136                                  r_check_passo_p2:
   137 000000B2 A1[0000]                    MOV AX, [p2_x]
   138 000000B5 A91000                      TEST AX, 0010h               ; Alterna sprite de passo do P2
   139 000000B8 74F4                        JZ r_normal_p2
   140 000000BA E8(0000)                    CALL desenha_p2_andando      ; Desenha pose andando
   141 000000BD C3                          RET
   142                                  r_agachado_p2:
   143 000000BE E8(0000)                    CALL desenha_p2_agachado     ; Desenha pose agachada
   144 000000C1 C3                          RET
   145                                  
   146                                  ; ROTINA DE ENCERRAMENTO E RESTAURAÇÃO DO SISTEMA
   147                                  sair_jogo:
   148 000000C2 B400                        MOV AH, 0   
   149 000000C4 A0[0000]                    MOV AL, [modo_anterior]      ; Restaura o modo de vídeo original do DOS
   150 000000C7 CD10                        INT 10h
   151 000000C9 E8(0000)                    CALL restaura_teclado        ; Restaura a interrupção original do teclado
   152 000000CC B8004C                      MOV AX, 4C00h                ; Encerra o programa com segurança
   153 000000CF CD21                        INT 21h
   154                                  
   155                                  ; ROTINA DE DELAY (ATRASO POR SOFTWARE)
   156                                  delay:
   157 000000D1 51                          PUSH CX
   158 000000D2 B90001                      MOV CX, 0100h       
   159                                  del2:
   160 000000D5 51                          PUSH CX
   161 000000D6 B90008                      MOV CX, 0800h       
   162                                  del1:
   163 000000D9 E2FE                        LOOP del1
   164 000000DB 59                          POP CX
   165 000000DC E2F7                        LOOP del2
   166 000000DE 59                          POP CX
   167 000000DF C3                          RET
   168                                  
   169                                  segment data
   170 00000000 00                          modo_anterior db 0           ; Armazena o modo de vídeo anterior
   171                                  
   172                                  segment stack stack
   173 00000000 <res 00000200>              resb 512
   174                                  stacktop:
