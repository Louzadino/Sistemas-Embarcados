     1                                  ; RESUMO: Módulo responsável por desenhar a arena de luta gráfica, 
     2                                  ; estabelecendo os limites superior (teto), inferior (chão), esquerdo 
     3                                  ; e direito para conter a movimentação dos lutadores.
     4                                  
     5                                  segment code
     6                                      global desenha_cenario      ; Torna a função visível para o main.asm
     7                                      
     8                                      extern line                 ; Importa a função de desenhar reta de outro módulo
     9                                      extern cor                  ; Importa a variável global de controle de cor
    10                                  
    11                                  desenha_cenario:
    12                                      ; Salva o contexto na pilha para preservar os registradores originais
    13 00000000 55                          PUSH BP
    14 00000001 89E5                        MOV BP, SP
    15 00000003 50                          PUSH AX
    16                                  
    17                                      ; Define a cor dos delimitadores da arena como branco intenso (15)
    18 00000004 C606[0000]0F                MOV byte [cor], 15
    19                                  
    20                                      ; 1. DESENHAR O CHÃO (Linha horizontal inferior)
    21                                      ; Coordenadas: X de 0 até 639, Y fixo em 50
    22 00000009 B80000                      MOV AX, 0
    23 0000000C 50                          PUSH AX
    24 0000000D B83200                      MOV AX, 50
    25 00000010 50                          PUSH AX
    26 00000011 B87F02                      MOV AX, 639
    27 00000014 50                          PUSH AX
    28 00000015 B83200                      MOV AX, 50
    29 00000018 50                          PUSH AX
    30 00000019 E8(0000)                    CALL line
    31                                  
    32                                      ; 2. DESENHAR O TETO / DELIMITADOR SUPERIOR (Linha horizontal superior)
    33                                      ; Coordenadas: X de 0 até 639, Y fixo em 300
    34 0000001C B80000                      MOV AX, 0
    35 0000001F 50                          PUSH AX
    36 00000020 B82C01                      MOV AX, 300
    37 00000023 50                          PUSH AX
    38 00000024 B87F02                      MOV AX, 639
    39 00000027 50                          PUSH AX
    40 00000028 B82C01                      MOV AX, 300
    41 0000002B 50                          PUSH AX
    42 0000002C E8(0000)                    CALL line
    43                                  
    44                                      ; 3. DESENHAR O LIMITE ESQUERDO (Linha vertical)
    45                                      ; Coordenadas: X fixo em 5, Y de 50 até 300
    46 0000002F B80500                      MOV AX, 5
    47 00000032 50                          PUSH AX
    48 00000033 B83200                      MOV AX, 50
    49 00000036 50                          PUSH AX
    50 00000037 B80500                      MOV AX, 5
    51 0000003A 50                          PUSH AX
    52 0000003B B82C01                      MOV AX, 300
    53 0000003E 50                          PUSH AX
    54 0000003F E8(0000)                    CALL line
    55                                  
    56                                      ; 4. DESENHAR O LIMITE DIREITO (Linha vertical)
    57                                      ; Coordenadas: X fixo em 634, Y de 50 até 300
    58 00000042 B87A02                      MOV AX, 634
    59 00000045 50                          PUSH AX
    60 00000046 B83200                      MOV AX, 50
    61 00000049 50                          PUSH AX
    62 0000004A B87A02                      MOV AX, 634
    63 0000004D 50                          PUSH AX
    64 0000004E B82C01                      MOV AX, 300
    65 00000051 50                          PUSH AX
    66 00000052 E8(0000)                    CALL line
    67                                  
    68                                      ; Restaura o contexto da pilha e retorna para a função chamadora
    69 00000055 58                          POP AX
    70 00000056 5D                          POP BP
    71 00000057 C3                          RET
