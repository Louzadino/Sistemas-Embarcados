     1                                  ; =====================================================================
     2                                  ; ARQUIVO: menu_inicial.asm  (versão corrigida)
     3                                  ; RESUMO: Menu de seleção de cores em duas colunas com círculos coloridos.
     4                                  ;   P1 escolhe via W / S (seta -> à esquerda dos círculos).
     5                                  ;   P2 escolhe via Seta Cima / Seta Baixo (seta <- à direita dos círculos).
     6                                  ;   ENTER confirma (usa a flag 'key_enter', setada pela ISR do teclado).
     7                                  ; Retorna em 'cor_p1' e 'cor_p2' a cor selecionada por cada jogador.
     8                                  ;
     9                                  ; Layout (modo 12h, 640x480, fonte 8x16, y dos círculos contado de baixo):
    10                                  ;   círculo i  -> linha de texto 8 + 3*i  (3 linhas = 48 px = espacamento_y)
    11                                  ;   centro y   -> base_y_circulo - i*48
    12                                  ; =====================================================================
    13                                  
    14                                  ; 0 = os dois jogadores NÃO podem confirmar com a mesma cor
    15                                  ; 1 = cores iguais permitidas
    16                                  %assign PERMITE_COR_IGUAL 0
    17                                  
    18                                  ; ---------------------------------------------------------------------
    19                                  ; Constantes do layout
    20                                  ; ---------------------------------------------------------------------
    21                                  pos_x_p1        equ 170     ; X do centro da coluna do P1 (pixels)
    22                                  pos_x_p2        equ 470     ; X do centro da coluna do P2 (pixels)
    23                                  base_y_circulo  equ 343     ; Y (de baixo) do centro do círculo 0 = 479 - (8*16+8)
    24                                  espacamento_y   equ 48      ; 3 linhas de texto (3*16)
    25                                  raio_disco      equ 16
    26                                  raio_anel       equ 19      ; anel de seleção (fica fora do disco)
    27                                  col_seta_p1     equ 17      ; coluna de texto da seta do P1
    28                                  col_seta_p2     equ 64      ; coluna de texto da seta do P2
    29                                  
    30                                  segment data
    31                                      global cor_p1, cor_p2
    32                                  
    33 00000000 0A                          cor_p1          db 10       ; Cor padrão P1 (Verde Claro)  -> índice 1
    34 00000001 0E                          cor_p2          db 14       ; Cor padrão P2 (Amarelo)      -> índice 4
    35                                  
    36 00000002 0100                        idx_p1          dw 1        ; índice selecionado por P1 (0 a 5)
    37 00000004 0400                        idx_p2          dw 4        ; índice selecionado por P2 (0 a 5)
    38 00000006 FFFF                        ult_p1          dw 0FFFFh   ; último índice desenhado (força 1º desenho)
    39 00000008 FFFF                        ult_p2          dw 0FFFFh
    40                                  
    41                                      ; 0: 8 (Cinza), 1: 10 (Verde Claro), 2: 11 (Ciano claro),
    42                                      ; 3: 13 (Magenta/Rosa claro), 4: 14 (Amarelo), 5: 15 (Branco)
    43 0000000A 080A0B0D0E0F                tabela_cores    db 8, 10, 11, 13, 14, 15
    44                                  
    45 00000010 4553434F4C48412053-         titulo_menu     db 'ESCOLHA SEU JOGADOR'                    ; 19
    46 00000019 4555204A4F4741444F-
    47 00000022 52                 
    48 00000023 4A4F4741444F522031          txt_p1          db 'JOGADOR 1'                              ; 9
    49 0000002C 4A4F4741444F522032          txt_p2          db 'JOGADOR 2'                              ; 9
    50 00000035 5052455353494F4E45-         txt_rodape      db 'PRESSIONE >ENTER< PARA COMECAR A LUTAR' ; 38
    51 0000003E 203E454E5445523C20-
    52 00000047 5041524120434F4D45-
    53 00000050 4341522041204C5554-
    54 00000059 4152               
    55                                  
    56 0000005B 1A                          seta_p1         db 0x1A     ; ->
    57 0000005C 1B                          seta_p2         db 0x1B     ; <-
    58                                  
    59                                      ; Travas de navegação (detecção de borda de subida)
    60 0000005D 00                          w_travado       db 0
    61 0000005E 00                          s_travado       db 0
    62 0000005F 00                          up_travado      db 0
    63 00000060 00                          down_travado    db 0
    64                                  
    65 00000061 00                          enter_armado    db 0        ; só aceita ENTER após ele ter sido solto
    66 00000062 00                          cor_salva       db 0        ; backup da variável global 'cor'
    67 00000063 0000                        sp_salvo        dw 0        ; backup de SP em torno das chamadas gráficas
    68                                  
    69                                  segment code
    70                                      global MENU_INICIAL
    71                                  
    72                                      extern escrever_na_tela, cor
    73                                      extern full_circle, circle
    74                                      extern key_w, key_s, key_up, key_down, key_enter
    75                                  
    76                                  ; ---------------------------------------------------------------------
    77                                  ; Macro: escreve texto. ptr, tamanho, linha, coluna, cor
    78                                  ; ---------------------------------------------------------------------
    79                                  %macro TEXTO 5
    80                                      MOV BP, %1
    81                                      MOV CX, %2
    82                                      MOV DH, %3
    83                                      MOV DL, %4
    84                                      MOV BL, %5
    85                                      CALL escreve
    86                                  %endmacro
    87                                  
    88                                  ; ---------------------------------------------------------------------
    89                                  ; Macro: desenha seta + anel de uma coluna para o índice SI.
    90                                  ; idx_var, ptr_seta, coluna_seta, x_circulo
    91                                  ; Selecionado -> branco; os demais -> preto (apaga o que havia antes).
    92                                  ; ---------------------------------------------------------------------
    93                                  %macro ITEM 4
    94                                      MOV BL, 0
    95                                      CMP SI, [%1]
    96                                      JNE %%nao_sel
    97                                      MOV BL, 0Fh
    98                                  %%nao_sel:
    99                                      ; seta: linha = 8 + 3*SI
   100                                      MOV AX, SI
   101                                      SHL AX, 1
   102                                      ADD AX, SI
   103                                      ADD AX, 8
   104                                      MOV DH, AL
   105                                      MOV DL, %3
   106                                      MOV BP, %2
   107                                      MOV CX, 1
   108                                      CALL escreve
   109                                      ; anel
   110                                      CALL y_do_circulo           ; DX = y
   111                                      MOV AX, %4
   112                                      MOV CX, raio_anel
   113                                      CALL anel
   114                                  %endmacro
   115                                  
   116                                  ; =====================================================================
   117                                  ; FUNÇÃO CENTRAL: MENU_INICIAL
   118                                  ; =====================================================================
   119                                  MENU_INICIAL:
   120 00000000 60                          PUSHA
   121 00000001 06                          PUSH ES
   122                                  
   123 00000002 1E                          PUSH DS                     ; ES = DS (INT 10h/13h lê a string em ES:BP)
   124 00000003 07                          POP ES
   125                                  
   126 00000004 A0[0000]                    MOV AL, [cor]               ; guarda a cor global
   127 00000007 A2[6200]                    MOV [cor_salva], AL
   128                                  
   129 0000000A C706[0600]FFFF              MOV word [ult_p1], 0FFFFh
   130 00000010 C706[0800]FFFF              MOV word [ult_p2], 0FFFFh
   131 00000016 C606[6100]00                MOV byte [enter_armado], 0
   132 0000001B C606[5D00]00                MOV byte [w_travado], 0
   133 00000020 C606[5E00]00                MOV byte [s_travado], 0
   134 00000025 C606[5F00]00                MOV byte [up_travado], 0
   135 0000002A C606[6000]00                MOV byte [down_travado], 0
   136                                  
   137 0000002F E89E00                      CALL desenha_estatico       ; textos + discos (uma única vez)
   138                                  
   139                                  loop_menu:
   140 00000032 E81002                      CALL delay_menu
   141                                  
   142 00000035 E86601                      CALL processa_input_p1
   143 00000038 E8B201                      CALL processa_input_p2
   144                                  
   145                                      ; Só redesenha setas/anéis se alguma seleção mudou
   146 0000003B A1[0200]                    MOV AX, [idx_p1]
   147 0000003E 3B06[0600]                  CMP AX, [ult_p1]
   148 00000042 7509                        JNE .redesenha
   149 00000044 A1[0400]                    MOV AX, [idx_p2]
   150 00000047 3B06[0800]                  CMP AX, [ult_p2]
   151 0000004B 7403                        JE .sem_mudanca
   152                                  .redesenha:
   153 0000004D E8DE00                      CALL desenha_selecao
   154                                  .sem_mudanca:
   155                                  
   156                                      ; ENTER: precisa ter sido solto ao menos uma vez desde a entrada
   157 00000050 803E[0000]01                CMP byte [key_enter], 1
   158 00000055 7408                        JE .enter_down
   159 00000057 C606[6100]01                MOV byte [enter_armado], 1
   160 0000005C E9D3FF                      JMP loop_menu
   161                                  .enter_down:
   162 0000005F 803E[6100]01                CMP byte [enter_armado], 1
   163 00000064 75CC                        JNE loop_menu
   164                                  
   165                                  %if PERMITE_COR_IGUAL = 0
   166 00000066 A1[0200]                    MOV AX, [idx_p1]
   167 00000069 3B06[0400]                  CMP AX, [idx_p2]
   168 0000006D 74C3                        JE loop_menu                ; mesma cor: ignora o ENTER
   169                                  %endif
   170                                  
   171                                      ; --- Salva as cores escolhidas ---
   172 0000006F 8B1E[0200]                  MOV BX, [idx_p1]
   173 00000073 8A87[0A00]                  MOV AL, [tabela_cores + BX]
   174 00000077 A2[0000]                    MOV [cor_p1], AL
   175                                  
   176 0000007A 8B1E[0400]                  MOV BX, [idx_p2]
   177 0000007E 8A87[0A00]                  MOV AL, [tabela_cores + BX]
   178 00000082 A2[0100]                    MOV [cor_p2], AL
   179                                  
   180 00000085 E8B401                      CALL apaga_menu
   181                                  
   182 00000088 A0[6200]                    MOV AL, [cor_salva]         ; restaura a cor global
   183 0000008B A2[0000]                    MOV [cor], AL
   184                                  
   185 0000008E 07                          POP ES
   186 0000008F 61                          POPA
   187 00000090 C3                          RET
   188                                  
   189                                  ; =====================================================================
   190                                  ; WRAPPERS SEGUROS PARA A BIBLIOTECA GRÁFICA
   191                                  ; (preservam todos os registradores e a pilha, qualquer que seja a
   192                                  ;  convenção de chamada: RET 6 ou cdecl)
   193                                  ; =====================================================================
   194                                  
   195                                  ; escreve: BP=string, CX=tamanho, DH=linha, DL=coluna, BL=cor
   196                                  escreve:
   197 00000091 60                          PUSHA
   198 00000092 E8(0000)                    CALL escrever_na_tela
   199 00000095 61                          POPA
   200 00000096 C3                          RET
   201                                  
   202                                  ; disco: AX=xc, DX=yc, CX=raio, BL=cor
   203                                  disco:
   204 00000097 60                          PUSHA
   205 00000098 881E[0000]                  MOV [cor], BL
   206 0000009C 8926[6300]                  MOV [sp_salvo], SP
   207 000000A0 50                          PUSH AX
   208 000000A1 52                          PUSH DX
   209 000000A2 51                          PUSH CX
   210 000000A3 E8(0000)                    CALL full_circle
   211 000000A6 8B26[6300]                  MOV SP, [sp_salvo]
   212 000000AA 61                          POPA
   213 000000AB C3                          RET
   214                                  
   215                                  ; anel: AX=xc, DX=yc, CX=raio, BL=cor
   216                                  anel:
   217 000000AC 60                          PUSHA
   218 000000AD 881E[0000]                  MOV [cor], BL
   219 000000B1 8926[6300]                  MOV [sp_salvo], SP
   220 000000B5 50                          PUSH AX
   221 000000B6 52                          PUSH DX
   222 000000B7 51                          PUSH CX
   223 000000B8 E8(0000)                    CALL circle
   224 000000BB 8B26[6300]                  MOV SP, [sp_salvo]
   225 000000BF 61                          POPA
   226 000000C0 C3                          RET
   227                                  
   228                                  ; y_do_circulo: SI=índice -> DX = base_y_circulo - SI*espacamento_y
   229                                  y_do_circulo:
   230 000000C1 50                          PUSH AX
   231 000000C2 89F0                        MOV AX, SI
   232 000000C4 BA3000                      MOV DX, espacamento_y
   233 000000C7 F7E2                        MUL DX                      ; DX:AX = AX*DX
   234 000000C9 BA5701                      MOV DX, base_y_circulo
   235 000000CC 29C2                        SUB DX, AX
   236 000000CE 58                          POP AX
   237 000000CF C3                          RET
   238                                  
   239                                  ; =====================================================================
   240                                  ; DESENHO ESTÁTICO (feito uma única vez)
   241                                  ; =====================================================================
   242                                  desenha_estatico:
   243 000000D0 60                          PUSHA
   244                                  
   245                                      TEXTO titulo_menu, 19, 3, 30, 0Fh
   246 000000D1 BD[1000]            <1>     MOV BP, %1
   247 000000D4 B91300              <1>     MOV CX, %2
   248 000000D7 B603                <1>     MOV DH, %3
   249 000000D9 B21E                <1>     MOV DL, %4
   250 000000DB B30F                <1>     MOV BL, %5
   251 000000DD E8B1FF              <1>     CALL escreve
   252                                      TEXTO txt_p1,       9, 6, 17, 0Fh
   253 000000E0 BD[2300]            <1>     MOV BP, %1
   254 000000E3 B90900              <1>     MOV CX, %2
   255 000000E6 B606                <1>     MOV DH, %3
   256 000000E8 B211                <1>     MOV DL, %4
   257 000000EA B30F                <1>     MOV BL, %5
   258 000000EC E8A2FF              <1>     CALL escreve
   259                                      TEXTO txt_p2,       9, 6, 55, 0Fh
   260 000000EF BD[2C00]            <1>     MOV BP, %1
   261 000000F2 B90900              <1>     MOV CX, %2
   262 000000F5 B606                <1>     MOV DH, %3
   263 000000F7 B237                <1>     MOV DL, %4
   264 000000F9 B30F                <1>     MOV BL, %5
   265 000000FB E893FF              <1>     CALL escreve
   266                                      TEXTO txt_rodape,  38, 26, 21, 0Fh
   267 000000FE BD[3500]            <1>     MOV BP, %1
   268 00000101 B92600              <1>     MOV CX, %2
   269 00000104 B61A                <1>     MOV DH, %3
   270 00000106 B215                <1>     MOV DL, %4
   271 00000108 B30F                <1>     MOV BL, %5
   272 0000010A E884FF              <1>     CALL escreve
   273                                  
   274 0000010D 31F6                        XOR SI, SI
   275                                  .disco_loop:
   276 0000010F E8AFFF                      CALL y_do_circulo           ; DX = y
   277 00000112 8A9C[0A00]                  MOV BL, [tabela_cores + SI]
   278 00000116 B91000                      MOV CX, raio_disco
   279 00000119 B8AA00                      MOV AX, pos_x_p1
   280 0000011C E878FF                      CALL disco
   281 0000011F B8D601                      MOV AX, pos_x_p2
   282 00000122 E872FF                      CALL disco
   283 00000125 46                          INC SI
   284 00000126 81FE0600                    CMP SI, 6
   285 0000012A 7CE3                        JL .disco_loop
   286                                  
   287 0000012C 61                          POPA
   288 0000012D C3                          RET
   289                                  
   290                                  ; =====================================================================
   291                                  ; DESENHO DA SELEÇÃO (setas + anéis) — só quando o índice muda
   292                                  ; =====================================================================
   293                                  desenha_selecao:
   294 0000012E 60                          PUSHA
   295                                  
   296 0000012F A1[0200]                    MOV AX, [idx_p1]
   297 00000132 A3[0600]                    MOV [ult_p1], AX
   298 00000135 A1[0400]                    MOV AX, [idx_p2]
   299 00000138 A3[0800]                    MOV [ult_p2], AX
   300                                  
   301 0000013B 31F6                        XOR SI, SI
   302                                  .loop:
   303                                      ITEM idx_p1, seta_p1, col_seta_p1, pos_x_p1
   304 0000013D B300                <1>     MOV BL, 0
   305 0000013F 3B36[0200]          <1>     CMP SI, [%1]
   306 00000143 7502                <1>     JNE %%nao_sel
   307 00000145 B30F                <1>     MOV BL, 0Fh
   308                              <1> %%nao_sel:
   309                              <1> 
   310 00000147 89F0                <1>     MOV AX, SI
   311 00000149 D1E0                <1>     SHL AX, 1
   312 0000014B 01F0                <1>     ADD AX, SI
   313 0000014D 050800              <1>     ADD AX, 8
   314 00000150 88C6                <1>     MOV DH, AL
   315 00000152 B211                <1>     MOV DL, %3
   316 00000154 BD[5B00]            <1>     MOV BP, %2
   317 00000157 B90100              <1>     MOV CX, 1
   318 0000015A E834FF              <1>     CALL escreve
   319                              <1> 
   320 0000015D E861FF              <1>     CALL y_do_circulo
   321 00000160 B8AA00              <1>     MOV AX, %4
   322 00000163 B91300              <1>     MOV CX, raio_anel
   323 00000166 E843FF              <1>     CALL anel
   324                                      ITEM idx_p2, seta_p2, col_seta_p2, pos_x_p2
   325 00000169 B300                <1>     MOV BL, 0
   326 0000016B 3B36[0400]          <1>     CMP SI, [%1]
   327 0000016F 7502                <1>     JNE %%nao_sel
   328 00000171 B30F                <1>     MOV BL, 0Fh
   329                              <1> %%nao_sel:
   330                              <1> 
   331 00000173 89F0                <1>     MOV AX, SI
   332 00000175 D1E0                <1>     SHL AX, 1
   333 00000177 01F0                <1>     ADD AX, SI
   334 00000179 050800              <1>     ADD AX, 8
   335 0000017C 88C6                <1>     MOV DH, AL
   336 0000017E B240                <1>     MOV DL, %3
   337 00000180 BD[5C00]            <1>     MOV BP, %2
   338 00000183 B90100              <1>     MOV CX, 1
   339 00000186 E808FF              <1>     CALL escreve
   340                              <1> 
   341 00000189 E835FF              <1>     CALL y_do_circulo
   342 0000018C B8D601              <1>     MOV AX, %4
   343 0000018F B91300              <1>     MOV CX, raio_anel
   344 00000192 E817FF              <1>     CALL anel
   345 00000195 46                          INC SI
   346 00000196 81FE0600                    CMP SI, 6
   347 0000019A 7CA1                        JL .loop
   348                                  
   349 0000019C 61                          POPA
   350 0000019D C3                          RET
   351                                  
   352                                  ; =====================================================================
   353                                  ; NAVEGAÇÃO DOS JOGADORES (0 a 5)
   354                                  ; =====================================================================
   355                                  processa_input_p1:
   356 0000019E 803E[0000]01                CMP byte [key_w], 1
   357 000001A3 751B                        JNE reseta_w_p1
   358 000001A5 803E[5D00]01                CMP byte [w_travado], 1
   359 000001AA 7419                        JE check_s_p1
   360 000001AC C606[5D00]01                MOV byte [w_travado], 1
   361 000001B1 813E[0200]0000              CMP word [idx_p1], 0
   362 000001B7 7E0C                        JLE check_s_p1
   363 000001B9 FF0E[0200]                  DEC word [idx_p1]
   364 000001BD E90500                      JMP check_s_p1
   365                                  reseta_w_p1:
   366 000001C0 C606[5D00]00                MOV byte [w_travado], 0
   367                                  
   368                                  check_s_p1:
   369 000001C5 803E[0000]01                CMP byte [key_s], 1
   370 000001CA 751B                        JNE reseta_s_p1
   371 000001CC 803E[5E00]01                CMP byte [s_travado], 1
   372 000001D1 7419                        JE fim_input_p1
   373 000001D3 C606[5E00]01                MOV byte [s_travado], 1
   374 000001D8 813E[0200]0500              CMP word [idx_p1], 5
   375 000001DE 7D0C                        JGE fim_input_p1
   376 000001E0 FF06[0200]                  INC word [idx_p1]
   377 000001E4 E90500                      JMP fim_input_p1
   378                                  reseta_s_p1:
   379 000001E7 C606[5E00]00                MOV byte [s_travado], 0
   380                                  fim_input_p1:
   381 000001EC C3                          RET
   382                                  
   383                                  processa_input_p2:
   384 000001ED 803E[0000]01                CMP byte [key_up], 1
   385 000001F2 751B                        JNE reseta_up_p2
   386 000001F4 803E[5F00]01                CMP byte [up_travado], 1
   387 000001F9 7419                        JE check_down_p2
   388 000001FB C606[5F00]01                MOV byte [up_travado], 1
   389 00000200 813E[0400]0000              CMP word [idx_p2], 0
   390 00000206 7E0C                        JLE check_down_p2
   391 00000208 FF0E[0400]                  DEC word [idx_p2]
   392 0000020C E90500                      JMP check_down_p2
   393                                  reseta_up_p2:
   394 0000020F C606[5F00]00                MOV byte [up_travado], 0
   395                                  
   396                                  check_down_p2:
   397 00000214 803E[0000]01                CMP byte [key_down], 1
   398 00000219 751B                        JNE reseta_down_p2
   399 0000021B 803E[6000]01                CMP byte [down_travado], 1
   400 00000220 7419                        JE fim_input_p2
   401 00000222 C606[6000]01                MOV byte [down_travado], 1
   402 00000227 813E[0400]0500              CMP word [idx_p2], 5
   403 0000022D 7D0C                        JGE fim_input_p2
   404 0000022F FF06[0400]                  INC word [idx_p2]
   405 00000233 E90500                      JMP fim_input_p2
   406                                  reseta_down_p2:
   407 00000236 C606[6000]00                MOV byte [down_travado], 0
   408                                  fim_input_p2:
   409 0000023B C3                          RET
   410                                  
   411                                  ; =====================================================================
   412                                  ; Limpa a tela e volta ao modo 640x480
   413                                  ; =====================================================================
   414                                  apaga_menu:
   415 0000023C 50                          PUSH AX
   416 0000023D B400                        MOV AH, 00h
   417 0000023F B012                        MOV AL, 12h
   418 00000241 CD10                        INT 10h
   419 00000243 58                          POP AX
   420 00000244 C3                          RET
   421                                  
   422                                  ; =====================================================================
   423                                  ; Espera 1 tick do relógio do BIOS (~55 ms), independente da CPU
   424                                  ; =====================================================================
   425                                  delay_menu:
   426 00000245 50                          PUSH AX
   427 00000246 06                          PUSH ES
   428 00000247 B84000                      MOV AX, 0040h
   429 0000024A 8EC0                        MOV ES, AX
   430 0000024C 26A16C00                    MOV AX, [ES:006Ch]
   431                                  .espera:
   432 00000250 263B066C00                  CMP AX, [ES:006Ch]
   433 00000255 74F9                        JE .espera
   434 00000257 07                          POP ES
   435 00000258 58                          POP AX
   436 00000259 C3                          RET
