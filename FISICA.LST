     1                                  ; RESUMO: Módulo responsável por gerenciar a física e os movimentos dos
     2                                  ; lutadores. Controla a gravidade, a mecânica de pulo, a verificação do
     3                                  ; estado de agachamento e a movimentação horizontal (esquerda/direita),
     4                                  ; garantindo também os limites da arena e a colisão de corpos no eixo X.
     5                                  
     6                                  segment data
     7                                      global p1_vy, p2_vy
     8                                      global p1_estado, p2_estado
     9                                      
    10 00000000 0000                        p1_vy dw 0          ; Velocidade vertical atual do Player 1
    11 00000002 0000                        p2_vy dw 0          ; Velocidade vertical atual do Player 2
    12 00000004 00                          p1_estado db 0      ; Estado do P1: 0 = Em pé, 1 = Agachado
    13 00000005 00                          p2_estado db 0      ; Estado do P2: 0 = Em pé, 1 = Agachado
    14                                  
    15                                  segment code
    16                                      global atualiza_movimento
    17                                      
    18                                      extern p1_x, p1_y, p2_x, p2_y
    19                                      extern key_a, key_d, key_left, key_right
    20                                      extern key_w, key_s, key_up, key_down
    21                                  
    22                                  ; FUNÇÃO CENTRAL: ATUALIZA_MOVIMENTO
    23                                  ; Orquestra a verificação de agachamento e a física de cada lutador
    24                                  atualiza_movimento:
    25 00000000 50                          PUSH AX
    26 00000001 E80800                      CALL estado_agachar
    27 00000004 E83800                      CALL fisica_p1
    28 00000007 E8AB00                      CALL fisica_p2
    29 0000000A 58                          POP AX
    30 0000000B C3                          RET
    31                                  
    32                                  ; ROTINA: ESTADO_AGACHAR
    33                                  ; Verifica se os jogadores estão tentando se abaixar (teclas S e Down)
    34                                  estado_agachar:
    35                                      ; Avalia o agachamento do Player 1 
    36 0000000C C606[0400]00                MOV byte [p1_estado], 0
    37 00000011 813E[0000]7300              CMP word [p1_y], 115        ; Se o P1 estiver no ar, não pode abaixar
    38 00000017 7F0C                        JG check_p2_crouch      
    39 00000019 803E[0000]01                CMP byte [key_s], 1         ; Verifica se a tecla S está pressionada
    40 0000001E 7505                        JNE check_p2_crouch
    41 00000020 C606[0400]01                MOV byte [p1_estado], 1     ; Define P1 como agachado
    42                                  
    43                                  check_p2_crouch:
    44                                      ; Avalia o agachamento do Player 2 
    45 00000025 C606[0500]00                MOV byte [p2_estado], 0
    46 0000002A 813E[0000]7300              CMP word [p2_y], 115        ; Se o P2 estiver no ar, não pode abaixar
    47 00000030 7F0C                        JG fim_agachar
    48 00000032 803E[0000]01                CMP byte [key_down], 1      ; Verifica se a tecla Seta para Baixo está pressionada
    49 00000037 7505                        JNE fim_agachar
    50 00000039 C606[0500]01                MOV byte [p2_estado], 1     ; Define P2 como agachado
    51                                  fim_agachar:
    52 0000003E C3                          RET
    53                                  
    54                                  ; ROTINA: FÍSICA DO PLAYER 1 (Pulo, Gravidade e Eixo X)
    55                                  fisica_p1:
    56                                      ; --- Tratamento do Pulo (P1) ---
    57 0000003F 813E[0000]7300              CMP word [p1_y], 115
    58 00000045 7F17                        JG aplica_gravidade_p1      ; Se estiver no ar, continua aplicando a gravidade
    59                                      
    60 00000047 803E[0400]01                CMP byte [p1_estado], 1
    61 0000004C 7431                        JE processa_x_p1            ; Se estiver agachado, não pode pular
    62                                      
    63 0000004E 803E[0000]01                CMP byte [key_w], 1         ; Verifica se a tecla W (pular) foi pressionada
    64 00000053 752A                        JNE processa_x_p1       
    65 00000055 C706[0000]1800              MOV word [p1_vy], 24        ; Aplica impulso inicial para cima (velocidade vertical)
    66 0000005B E90000                      JMP aplica_gravidade_p1
    67                                  
    68                                  aplica_gravidade_p1:
    69 0000005E A1[0000]                    MOV AX, [p1_vy]
    70 00000061 0106[0000]                  ADD word [p1_y], AX         ; Atualiza a posição Y com base na velocidade vertical
    71 00000065 812E[0000]0400              SUB word [p1_vy], 4         ; Aplica o efeito da gravidade (reduz a velocidade de subida/aumenta queda)
    72                                  
    73 0000006B 813E[0000]7300              CMP word [p1_y], 115
    74 00000071 7F0C                        JG processa_x_p1
    75 00000073 C706[0000]7300              MOV word [p1_y], 115        ; Garante que o lutador aterre no nível do chão (Y = 115)
    76 00000079 C706[0000]0000              MOV word [p1_vy], 0         ; Zera a velocidade vertical ao aterrissar
    77                                  
    78                                  processa_x_p1:
    79                                      ; Movimentação Horizontal no Eixo X (P1) 
    80 0000007F 803E[0400]01                CMP byte [p1_estado], 1
    81 00000084 742E                        JE fim_fisica_p1            ; Se estiver agachado, não se desloca horizontalmente
    82                                  
    83                                      ; Movimento para a Esquerda (Tecla A)
    84 00000086 803E[0000]01                CMP byte [key_a], 1
    85 0000008B 750E                        JNE tenta_d
    86 0000008D 813E[0000]1900              CMP word [p1_x], 25         ; Limite esquerdo da tela/arena
    87 00000093 7E06                        JLE tenta_d
    88 00000095 812E[0000]0300              SUB word [p1_x], 3          ; Move para a esquerda
    89                                  
    90                                  tenta_d:
    91                                      ; Movimento para a Direita (Tecla D)
    92 0000009B 803E[0000]01                CMP byte [key_d], 1
    93 000000A0 7512                        JNE fim_fisica_p1
    94 000000A2 A1[0000]                    MOV AX, [p2_x]
    95 000000A5 2D2800                      SUB AX, 40                  ; Impede que P1 atravesse a posição de P2
    96 000000A8 3906[0000]                  CMP [p1_x], AX
    97 000000AC 7D06                        JGE fim_fisica_p1
    98 000000AE 8106[0000]0300              ADD word [p1_x], 3          ; Move para a direita
    99                                  fim_fisica_p1:
   100 000000B4 C3                          RET
   101                                  
   102                                  ; ROTINA: FÍSICA DO PLAYER 2 (Pulo, Gravidade e Eixo X)
   103                                  fisica_p2:
   104                                      ; Tratamento do Pulo (P2) 
   105 000000B5 813E[0000]7300              CMP word [p2_y], 115
   106 000000BB 7F17                        JG aplica_gravidade_p2
   107                                      
   108 000000BD 803E[0500]01                CMP byte [p2_estado], 1
   109 000000C2 7431                        JE processa_x_p2
   110                                      
   111 000000C4 803E[0000]01                CMP byte [key_up], 1        ; Verifica se a tecla Seta para Cima foi pressionada
   112 000000C9 752A                        JNE processa_x_p2
   113 000000CB C706[0200]1800              MOV word [p2_vy], 24        ; Impulso inicial para cima
   114 000000D1 E90000                      JMP aplica_gravidade_p2
   115                                  
   116                                  aplica_gravidade_p2:
   117 000000D4 A1[0200]                    MOV AX, [p2_vy]
   118 000000D7 0106[0000]                  ADD word [p2_y], AX
   119 000000DB 812E[0200]0400              SUB word [p2_vy], 4         ; Gravidade
   120                                  
   121 000000E1 813E[0000]7300              CMP word [p2_y], 115
   122 000000E7 7F0C                        JG processa_x_p2
   123 000000E9 C706[0000]7300              MOV word [p2_y], 115        ; Reseta ao tocar o chão
   124 000000EF C706[0200]0000              MOV word [p2_vy], 0
   125                                  
   126                                  processa_x_p2:
   127                                      ; Movimentação Horizontal no Eixo X (P2) 
   128 000000F5 803E[0500]01                CMP byte [p2_estado], 1
   129 000000FA 742E                        JE fim_fisica_p2       
   130                                  
   131                                      ; Movimento para a Esquerda (Tecla Seta Esquerda)
   132 000000FC 803E[0000]01                CMP byte [key_left], 1
   133 00000101 7512                        JNE tenta_right
   134 00000103 A1[0000]                    MOV AX, [p1_x]
   135 00000106 052800                      ADD AX, 40                  ; Impede que P2 atravesse P1
   136 00000109 3906[0000]                  CMP [p2_x], AX
   137 0000010D 7E06                        JLE tenta_right
   138 0000010F 812E[0000]0300              SUB word [p2_x], 3
   139                                  
   140                                  tenta_right:
   141                                      ; Movimento para a Direita (Tecla Seta Direita)
   142 00000115 803E[0000]01                CMP byte [key_right], 1
   143 0000011A 750E                        JNE fim_fisica_p2
   144 0000011C 813E[0000]6602              CMP word [p2_x], 614        ; Limite direito da arena
   145 00000122 7D06                        JGE fim_fisica_p2
   146 00000124 8106[0000]0300              ADD word [p2_x], 3
   147                                  fim_fisica_p2:
   148 0000012A C3                          RET
